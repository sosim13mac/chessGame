<resources>
    <style name="Theme.VideoCatcher" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorPrimaryDark">@color/bar_background</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/bar_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.VideoCatcher.Sheet" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.55</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:windowAnimationStyle">@style/SheetAnimation</item>
    </style>
</resources>
