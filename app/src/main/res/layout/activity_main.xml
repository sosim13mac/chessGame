<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bar_background"
    android:orientation="vertical">

    <!-- Address bar -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">

        <EditText
            android:id="@+id/url_input"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_url_field"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="8dp"
            android:drawableTint="@color/text_tertiary"
            android:hint="@string/url_hint"
            android:imeOptions="actionGo|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:selectAllOnFocus="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btn_reload"
            style="@style/Widget.VideoCatcher.ToolbarButton"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/action_reload"
            android:src="@drawable/ic_refresh" />

        <ImageButton
            android:id="@+id/btn_menu"
            style="@style/Widget.VideoCatcher.ToolbarButton"
            android:contentDescription="@string/action_menu"
            android:src="@drawable/ic_more_vert" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="100"
        android:maxHeight="2dp"
        android:minHeight="2dp"
        android:progressDrawable="@drawable/progress_horizontal"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/window_background">

        <WebView
            android:id="@+id/web_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Shown for a few seconds when a video starts playing. -->
        <LinearLayout
            android:id="@+id/detect_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_pill"
            android:clickable="true"
            android:elevation="6dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_play_circle"
                android:tint="@color/brand_soft" />

            <TextView
                android:id="@+id/detect_pill_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:ellipsize="end"
                android:maxWidth="230dp"
                android:maxLines="2"
                android:textColor="@color/pill_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/detect_pill_action"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_pill_action"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/download"
                android:textColor="@color/brand_on"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom navigation -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/Widget.VideoCatcher.BottomBarButton"
            android:contentDescription="@string/action_back"
            android:src="@drawable/ic_arrow_back" />

        <ImageButton
            android:id="@+id/btn_forward"
            style="@style/Widget.VideoCatcher.BottomBarButton"
            android:contentDescription="@string/action_forward"
            android:src="@drawable/ic_arrow_forward" />

        <ImageButton
            android:id="@+id/btn_home"
            style="@style/Widget.VideoCatcher.BottomBarButton"
            android:contentDescription="@string/action_home"
            android:src="@drawable/ic_home" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/btn_videos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_videos"
                android:scaleType="center"
                android:src="@drawable/ic_video_library"
                android:tint="@color/icon_tint" />

            <TextView
                android:id="@+id/video_badge"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:layout_marginStart="18dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_badge"
                android:gravity="center"
                android:minWidth="18dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textColor="@color/badge_text"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/btn_downloads"
            style="@style/Widget.VideoCatcher.BottomBarButton"
            android:contentDescription="@string/action_downloads"
            android:src="@drawable/ic_download" />
    </LinearLayout>
</LinearLayout>
